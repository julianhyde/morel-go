Sys.set ("printLength", 64);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit

(*) Query in Hybrid mode (100% Calcite)
Sys.set ("hybrid", true);
> val it = () : unit

(*) Equivalent, using map
map (fn e => {a = 1, b = true}) [];
> val it = [] : {a:int, b:bool} list

(*) Equivalent, using map
map (fn e => {a = 1 + e, b = true}) [];
> val it = [] : {a:int, b:bool} list

(*) Equivalent, using map
map (fn e => {a = 1, b = true}) [0];
> val it = [{a=1,b=true}] : {a:int, b:bool} list

(*) Recursive query
(*
let
  fun descendants level oldEmps newEmps =
    let
      val pred =
        if (exists prev) then
          fn e => e.mgr in (from p in newEmps
                            yield p.empno)
        else
          fn e => e.mgr = 0
      val nextEmps = from e in scott.emps
        where (pred e)
        yield {level, e.empno}
    in
      if (exists nextEmps) then
        descendants (level + 1) (oldEmps union newEmps) nextEmps
      else
        (oldEmps union newEmps)
    end
  in
end;
*)

(*) Recursive query, 2
(*
let
  fun descendants () =
    (from e in scott.emps
      where e.mgr = 0
      yield {e, level = 0})
    union
    (from d in descendants (),
        e in scott.emps
      where e.mgr = d.e.empno
      yield {e, level = d.level + 1});
in
  descendants ()
end;
*)

(*) Recursive query, 3
Sys.set ("hybrid", false);
> val it = () : unit

(* 'max' and 'min' over a type that the Calcite adapter cannot order the way
   Morel does -- 'word' (which Calcite compares as a signed integer) or a
   composite type such as a tuple or 'option' -- run locally rather than being
   pushed to Calcite, giving the right answer rather than crashing. 'Sys.plan'
   confirms the plan has no 'calcite' node. See the Calcite adapter limitations
   in 'docs/reference.md'. *)
Sys.set ("hybrid", true);
> val it = () : unit
Sys.set ("hybrid", false);
> val it = () : unit

"end";
> val it = "end" : string

(*) End hybrid.smli
