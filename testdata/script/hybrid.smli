  in
end;
*)

(*) Recursive query, 2
(*
let
  fun descendants () =
    (from e in scott.emps
      where e.mgr = NONE
      yield {e, level = 0})
    union
    (from d in descendants (),
        e in scott.emps
      where e.mgr = SOME d.e.empno
      yield {e, level = d.level + 1});
in
  descendants ()
end;
*)

(*) Recursive query, 3
Sys.set ("hybrid", false);
> val it = () : unit
let
  fun descendants2 descendants newDescendants =
    if empty newDescendants then
      descendants
    else
      descendants2 (from d in descendants union newDescendants)
          (from d in newDescendants,
              e in scott.emps
            where e.mgr = SOME d.e.empno
            yield {e, level = d.level + 1})
in
  from d in descendants2 Bag.nil
      (from e in scott.emps
        where e.mgr = NONE
        yield {e, level = 0})
    yield {d.e.empno, d.e.mgr, d.e.ename, d.level}
end;
> val it =
>   [{empno=7839,ename="KING",level=0,mgr=NONE},
>    {empno=7566,ename="JONES",level=1,mgr=SOME 7839},
>    {empno=7698,ename="BLAKE",level=1,mgr=SOME 7839},
>    {empno=7782,ename="CLARK",level=1,mgr=SOME 7839},
>    {empno=7788,ename="SCOTT",level=2,mgr=SOME 7566},
>    {empno=7902,ename="FORD",level=2,mgr=SOME 7566},
>    {empno=7499,ename="ALLEN",level=2,mgr=SOME 7698},
>    {empno=7521,ename="WARD",level=2,mgr=SOME 7698},
>    {empno=7654,ename="MARTIN",level=2,mgr=SOME 7698},
>    {empno=7844,ename="TURNER",level=2,mgr=SOME 7698},
>    {empno=7900,ename="JAMES",level=2,mgr=SOME 7698},
>    {empno=7934,ename="MILLER",level=2,mgr=SOME 7782},
>    {empno=7876,ename="ADAMS",level=3,mgr=SOME 7788},
>    {empno=7369,ename="SMITH",level=3,mgr=SOME 7902}]
>   : {empno:int, ename:string, level:int, mgr:int option} bag

(* 'max' and 'min' over a type that the Calcite adapter cannot order the way
 * Morel does -- 'word' (which Calcite compares as a signed integer) or a
 * composite type such as a tuple or 'option' -- run locally rather than being
 * pushed to Calcite, giving the right answer rather than crashing. 'Sys.plan'
 * confirms the plan has no 'calcite' node. See the Calcite adapter limitations
 * in 'docs/reference.md'. *)
Sys.set ("hybrid", true);
> val it = () : unit
from w in [0w1, 0wxFFFFFFFFFFFFFFFF] compute max over w;
> val it = 0wxFFFFFFFFFFFFFFFF : word
from p in [(1, 2), (2, 1), (1, 9)] compute max over p;
> val it = (2,1) : int * int
from ox in [SOME 1, NONE, SOME 3] compute min over ox;
> val it = NONE : int option
Sys.set ("hybrid", false);
> val it = () : unit

(* A column that contains nulls, such as 'comm' and 'mgr' in 'scott.emps', has
 * an option type. Values read via Calcite are converted to 'NONE' or 'SOME'. *)
Sys.set ("hybrid", true);
> val it = () : unit
from e in scott.emps where e.deptno = 30 yield {e.ename, e.comm};
> val it =
>   [{comm=SOME 300,ename="ALLEN"},{comm=SOME 500,ename="WARD"},
>    {comm=SOME 1400,ename="MARTIN"},{comm=NONE,ename="BLAKE"},
>    {comm=SOME 0,ename="TURNER"},{comm=NONE,ename="JAMES"}]
>   : {comm:decimal option, ename:string} bag
from e in scott.emps where e.deptno = 10 yield e.mgr;
> val it = [SOME 7839,NONE,SOME 7782] : int option bag
from e in scott.emps where e.comm = NONE andalso e.deptno = 30 yield e.ename;
> val it = ["BLAKE","JAMES"] : string bag
from e in scott.emps where e.mgr = SOME 7698 yield e.ename;
> val it = ["ALLEN","WARD","MARTIN","TURNER","JAMES"] : string bag
(* 'NONE' is less than any 'SOME', so KING (who has no manager) is included. *)
from e in scott.emps where e.mgr < SOME 7700 yield e.ename;
> val it = ["ALLEN","WARD","MARTIN","SCOTT","KING","TURNER","JAMES","FORD"]
>   : string bag
from e in scott.emps
  where Option.isSome e.comm
  yield (e.ename, valOf e.comm);
> val it = [("ALLEN",300),("WARD",500),("MARTIN",1400),("TURNER",0)]
>   : (string * decimal) bag
from e in scott.emps
  group e.deptno compute {c = count over (), s = sum over e.sal};
> val it =
>   [{c=5,deptno=20,s=10875},{c=3,deptno=10,s=8750},{c=6,deptno=30,s=9400}]
>   : {c:int, deptno:int, s:decimal} bag
(* A DECIMAL column has type 'decimal'. A 'decimal' literal is converted at
 * compile time, and becomes a SQL DECIMAL literal. *)
from e in scott.emps where e.sal > decimal "2900" yield {e.ename, e.sal};
> val it =
>   [{ename="JONES",sal=2975},{ename="SCOTT",sal=3000},{ename="KING",sal=5000},
>    {ename="FORD",sal=3000}] : {ename:string, sal:decimal} bag
(* Decimal values from Morel keep their scale when passed to Calcite. *)
from e in scott.emps, x in [decimal "1250.5", decimal "2975.25"]
  where e.sal < x andalso e.deptno = 30
  yield {e.ename, e.sal, x};
> val it =
>   [{ename="ALLEN",sal=1600,x=2975.25},{ename="WARD",sal=1250,x=1250.5},
>    {ename="WARD",sal=1250,x=2975.25},{ename="MARTIN",sal=1250,x=1250.5},
>    {ename="MARTIN",sal=1250,x=2975.25},{ename="BLAKE",sal=2850,x=2975.25},
>    {ename="TURNER",sal=1500,x=2975.25},{ename="JAMES",sal=950,x=1250.5},
>    {ename="JAMES",sal=950,x=2975.25}]
>   : {ename:string, sal:decimal, x:decimal} bag
(* A call to an operator in a structure, such as 'Decimal.*', is sent to
 * Calcite as Morel code, and the operator name is quoted, as in '#`*`'. *)
from x in [decimal "1.25", decimal "2.5", decimal "0.001"]
  yield Decimal.`*` (x, decimal "2");
> val it = [2.5,5,0.002] : decimal list
(* Arithmetic on 'decimal' values is evaluated by Morel, not Calcite, because
 * Calcite's DECIMAL type has less precision. *)
from e in scott.emps
  where e.deptno = 10
  yield {e.ename, pay = e.sal * decimal "1.05" + getOpt (e.comm, decimal "0")};
> val it =
>   [{ename="CLARK",pay=2572.5},{ename="KING",pay=5250},
>    {ename="MILLER",pay=1365}] : {ename:string, pay:decimal} bag
(* Comparing a 'decimal option' column using '=' or '<>' is translated to
 * '=' and 'IS NULL', not 'IS NOT DISTINCT FROM', because the values in the
 * column and in the query may have different scales. *)
from e in scott.emps where e.comm = SOME (decimal "300") yield e.ename;
> val it = ["ALLEN"] : string bag
from e in scott.emps where e.comm = SOME (decimal "1400") yield e.ename;
> val it = ["MARTIN"] : string bag
from e in scott.emps where e.comm <> SOME (decimal "300") compute count over ();
> val it = 13 : int
(* A 'decimal' literal that Calcite cannot represent is evaluated by Morel.
 * An integer must fit in a BIGINT. *)
from e in scott.emps where e.sal < decimal "9999999999999999999"
  compute count over ();
> val it = 14 : int
from e in scott.emps where e.sal < decimal "1E100" compute count over ();
> val it = 14 : int
from e in scott.emps where e.sal > decimal "0.000000000000000000001"
  compute count over ();
> val it = 14 : int
Sys.set ("hybrid", false);
> val it = () : unit

"end";
> val it = "end" : string

(*) End hybrid.smli
