 *
 * Queries that must give the same answer whether evaluated
 * locally or pushed down to Apache Calcite.
 *
 * Morel-Java's suite runs this script twice (see
 * ScriptTest.testScriptDual): once in local mode, and once in
 * Calcite ("hybrid") mode with a tracer that fails if any query is
 * not pushed down. So do not add queries that cannot be pushed down,
 * and do not call Sys.plan (whose output differs between modes).
 *
 * Morel-Rust cannot push queries down to SQL, so runs this test
 * only in local mode.
 *)

(* Configuration statements cannot be pushed down; the tracer's deny list
 * exempts calls to the Sys structure. *)
Sys.set ("printLength", 64);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit
Sys.set ("output", "tabular");
> val it = () : unit

from n in [1,2,3] yield n;
> val it = [1,2,3] : int list
from n in [1,2,3] where n mod 2 = 1 andalso n < 3 yield n;
> val it = [1] : int list
from n in [1,2,3] where false yield n;
> val it = [] : int list
from n in [1,2,3] where n < 2 orelse n > 2 yield n * 3;
> val it = [3,9] : int list
from r in [{a=1,b=2},{a=1,b=0},{a=2,b=1}]
  order (DESC r.a, r.b)
  yield {r.a, b10 = r.b * 10};
> a b10
> - ---
> 2  10
> 1   0
> 1  20
>
> val it : {a:int, b10:int} list

from r in [{a=2,b=3},{a=2,b=1},{a=1,b=1}]
  group r.a
  order a;
> val it = [1,2] : int list

from r in [{a=2,b=3},{a=2,b=1},{a=1,b=1}]
  group {} compute sum over r.b;
> val it = [5] : int list

from r in [{a=2,b=3},{a=2,b=1},{a=1,b=1}]
  group r.a
  yield a
  order a;
> val it = [1,2] : int list

from r in [{a=2,b=3}]
group r.b compute {sb = sum over r.b,
    mb = min over r.b, a = count over ()};
> a b mb sb
> - - -- --
> 1 3  3  3
>
> val it : {a:int, b:int, mb:int, sb:int} list

from r in [{a=2,b=3}]
group r.b compute {sb = sum over r.b,
    mb = min over r.b, a = count over ()}
yield {a, a2 = a + b, sb};
> a a2 sb
> - -- --
> 1  4  3
>
> val it : {a:int, a2:int, sb:int} list

from i in [1, 2, 3] union [2, 5, 4];
> val it = [1,2,3,2,5,4] : int list
from i in [1, 2, 3] union [2, 5, 4], [2, 1, 7];
> val it = [1,2,3,2,5,4,2,1,7] : int list
from i in [1, 2, 3] intersect [2, 5, 4];
> val it = [2] : int list
from i in [1, 2, 3] intersect [2, 5, 4], [2, 1, 6];
> val it = [2] : int list
from i in [1, 2, 3] intersect [1, 2, 3], [99];
> val it = [] : int list
from i in [1, 2, 3] except [2, 5, 4];
> val it = [1,3] : int list
from i in [1, 2, 3] except [2, 5, 4], [2, 1, 6];
> val it = [3] : int list

(*) Intersect, except, concat via List methods
List.`except` [[1, 2, 3], [2, 5, 4]];
> val it = [1,3] : int list
List.`intersect` [[1, 2, 3], [2, 5, 4]];
> val it = [2] : int list
List.`except` [[1, 2, 3], [2, 5, 4], [2, 1, 6]];
> val it = [3] : int list
List.`intersect` [[1, 2, 3], [2, 5, 4], [2, 1, 6]];
> val it = [2] : int list
List.`intersect` [[1, 1, 2, 3], [1, 1, 5]];
> val it = [1,1] : int list
List.concat [[1, 2], [3], [4, 5]];
> val it = [1,2,3,4,5] : int list

(*) Collections of collections
[[1, 2], [3]];
> val it = [[1,2],[3]] : int list list
[bag [1, 2], bag [3]];
> val it = [[1,2],[3]] : int bag list
from l in [[1, 2], [3]];
> val it = [[1,2],[3]] : int list list
from l in [[1, 2], [3]] yield List.length l;
> val it = [2,1] : int list
Bag.concat [bag [1, 2], bag [3]];
> val it = [1,2,3] : int bag

(*) End dual.smli
