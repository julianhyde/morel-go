>    {x="b",y="d",z="e"},{x="b",y="d",z="f"}]
>   : {x:string, y:string, z:string} list

(*) join
from e in emps, d in depts
  where e.deptno = d.deptno
  yield {id = e.id, deptno = e.deptno, ename = e.name, dname = d.name};
