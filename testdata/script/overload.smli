 *
 * Tests for operator overloading.
 *)
Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("printLength", 64);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit

(*) Enable functions in the 'Test' structure.
Sys.set ("excludeStructures", "");
> val it = () : unit

(* -------------------------------------------------------------------
 * Example based on "A Second Look at Overloading" by Martin Odersky,
 * Philip Wadler, Martin Wehr (1995).
 *)
over first;
> over first
over second;
> over second
over third;
> over third

(* -------------------------------------------------------------------
 * A qualified value can be aliased, and can be used inside another
 * qualified value; the dictionaries are forwarded. *)
over inc;
> over inc

(* As previous, but at top level. *)
over o1a;
> over o1a
over o0;
> over o0

(* As previous, but at top level. *)
over o4a;
> over o4a

(* -------------------------------------------------------------------
 * The 'unorder' operator will help us mix lists and bags in queries. *)

(* A type similar to the built-in 'bag', and a function to convert any list to
   a multiset. *)
datatype 'a multiset =
    MULTI_NIL
  | MULTI_CONS of ('a * 'a multiset);
> datatype 'a multiset = MULTI_NIL | MULTI_CONS of 'a * 'a multiset
fun listToMultiset [] = MULTI_NIL
  | listToMultiset (h :: t) = MULTI_CONS (h, listToMultiset t);
> val listToMultiset = fn : 'a list -> 'a multiset

(* Declare that 'unsort' is overloaded. *)
over unsort;
> over unsort

(* -------------------------------------------------------------------
 * The 'scan' operator allows us to read lists and bags. *)
over scan;
> over scan

(* -------------------------------------------------------------------
 * An overloaded aggregate function is resolved based on whether the input is
 * ordered. *)
over overAgg;
> over overAgg

(* A non-overloaded aggregate function can adapt.
 * 1. List agg applied to list *)
from i in [1, 2, 3]
  compute List.hd over i;
> val it = 1 : int
(*) 4. Bag agg applied to bag
from i in bag [1, 2, 3]
  compute Bag.hd over i;
> val it = 1 : int

(*) A user-defined aggregate works regardless of its collection kind.
let
  fun count_list list = List.length list
  fun count_bag bag = Bag.length bag
  val emps = [
      {id = 100, name = "Fred", deptno = 10},
      {id = 101, name = "Velma", deptno = 20},
      {id = 102, name = "Shaggy", deptno = 30},
      {id = 103, name = "Scooby", deptno = 30}]
in
  from e in emps
    group e.deptno
      compute {c1 = count_list over (), c2 = count_bag over ()}
    order deptno
end;
> val it = [{c1=1,c2=1,deptno=10},{c1=1,c2=1,deptno=20},{c1=2,c2=2,deptno=30}]
>   : {c1:int, c2:int, deptno:int} list

(*) Non-overloaded aggregates adapt via into
from i in [1, 2, 3] into List.hd;
> val it = 1 : int

from i in bag [1, 2, 3] into Bag.hd;
> val it = 1 : int

(*) End overload.smli
