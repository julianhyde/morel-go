 * Queries on the 'scott' data set (emps and depts), as tables.
 *)
useSilently "scott.smli";
> [opening scott.smli]
> val it = () : unit

(* A local data set of assignments; the last references an employee (9999) who
 * is not in 'scott.emps'. *)
val assignments =
  [{empno = 7839, task = "Plan budget"},
   {empno = 7566, task = "Review code"},
   {empno = 9999, task = "Orphaned task"}];
> val assignments =
>   [{empno=7839,task="Plan budget"},{empno=7566,task="Review code"},
>    {empno=9999,task="Orphaned task"}] : {empno:int, task:string} list
Sys.set ("output", "tabular");
> val it = () : unit

Sys.set ("output", "classic");
> val it = () : unit

(*) End scott-queries.smli
